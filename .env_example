# Modelo usado pelos agentes. Opções:
#   gemini/gemini-2.5-flash  -> gratuito (requer GEMINI_API_KEY)
#   ollama/llama3.1          -> gratuito, roda no seu computador (requer Ollama instalado)
#   gpt-4.1-mini             -> OpenAI, pago (requer OPENAI_API_KEY)
MODEL=gemini/gemini-2.5-flash

# Preencha apenas a chave do provedor escolhido acima.
GEMINI_API_KEY=YOUR_KEY_HERE
OPENAI_API_KEY=

# Opcional: habilita busca na web no agente de Marketing.
SERPER_API_KEY=

# Opcional: senha para acessar a interface web (app.py).
APP_PASSWORD=
