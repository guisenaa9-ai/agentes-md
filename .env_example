# Modelo usado pelos agentes. Opções:
#   gemini/gemini-2.5-flash  -> gratuito (requer GEMINI_API_KEY)
#   ollama/llama3.1          -> gratuito, roda no seu computador (requer Ollama instalado)
#   gpt-4.1-mini             -> OpenAI, pago (requer OPENAI_API_KEY)
MODEL=gemini/gemini-2.5-flash

# Preencha apenas a chave do provedor escolhido acima.
GEMINI_API_KEY=YOUR_KEY_HERE
OPENAI_API_KEY=

# Opcional: habilita busca na web no agente de Marketing.
SERPER_API_KEY=

# Obrigatória para a interface web (app.py): sem ela o app fica bloqueado.
APP_PASSWORD=

# Obrigatório para a API (api.py): token longo e aleatório, enviado no cabeçalho
# "Authorization: Bearer <API_TOKEN>". Sem ele a API recusa todas as chamadas (503).
# Gere um com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
